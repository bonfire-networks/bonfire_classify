{!-- in search results, groups and topics share the group card --}
{#case {e(@object, :type, nil), @showing_within}}
  {#match {type, showing_within} when type == :group or showing_within == :search}
    <StatelessComponent
      module={maybe_component(Bonfire.UI.Groups.Preview.GroupLive, @__context__)}
      object={@object}
      object_boundary={@object_boundary}
      permalink={@permalink}
      showing_within={@showing_within}
    />
  {#match _}
    <div class="flex w-full mt-2 border rounded-lg media_container  border-secondary">
      <LinkLive
        to={@permalink}
        class="flex hover:bg-base-content/5 items-center flex-1 gap-4 font-medium text-base-content"
      >
        {#case Media.avatar_url(@object)}
          {#match "/images/avatar.png"}
            <span class="rounded-none object-cover flex border-r border-secondary place-content-center items-center rounded-l-lg  cursor-pointer m-image w-[120px] h-[120px]">
              <#Icon iconify="mdi:account-group" class="w-9 h-9 text-muted" />
            </span>
          {#match url}
            <div
              data-role="group-card-icon"
              data-sensitive={Bonfire.Classify.Categories.sensitive?(@object)}
              class="relative flex items-center rounded-l-lg shrink-0 w-[120px] h-[120px] bg-base-content/10 place-content-center"
            >
              <LazyImage
                src={url}
                class="rounded-none object-cover rounded-l-lg  cursor-pointer m-image w-[120px] h-[120px]"
              />
              {!-- a topic marked sensitive: its icon blurred, as a sensitive post's media is --}
              <div
                :if={Bonfire.Classify.Categories.sensitive?(@object)}
                id={sensitive_part_id("icon", @object, @showing_within)}
                class="absolute inset-0 backdrop-blur-sm bg-black/50 z-40 cursor-pointer rounded-l-lg"
              />
            </div>
        {/case}

        <div class="flex flex-col">
          <div class="font-medium text-base">
            {rich(name(@object))}
          </div>
          <span
            :if={Bonfire.Classify.Categories.sensitive?(@object)}
            data-role="sensitive_badge"
            class="badge badge-warning badge-sm gap-1"
          ><#Icon iconify="ph:warning-circle" class="size-3.5" />{l("Sensitive content")}</span>
          {!-- hidden for a topic marked sensitive; still indexed, so a word in it still finds the topic --}
          <div
            id={sensitive_part_id("summary", @object, @showing_within)}
            data-role="group-card-summary"
            class={[
              "max-w-full prose-sm prose line-clamp-2 !text-muted !text-xs",
              hidden: Bonfire.Classify.Categories.sensitive?(@object)
            ]}
          >{e(@object, :profile, :summary, "")}</div>
        </div>
        {!-- <div class="text-sm font-normal text-muted">{Bonfire.Me.Characters.display_username(e(@object, :character, :username, nil), true)}</div> --}
      </LinkLive>
      <div class="flex items-center border-l border-secondary w-[120px] gap-1 md:gap-2">
        <Bonfire.Classify.Web.CategoryActionsLive
          object={@object}
          activity_id={id(@activity)}
          object_boundary={@object_boundary}
          object_type={e(@object, :type, nil)}
        />
      </div>
    </div>
{/case}