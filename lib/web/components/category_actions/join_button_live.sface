<div>
  {#if @combined}
    <div class="flex items-center gap-3">
      {#if @my_membership == nil and current_user_id(@__context__)}
        <button type="button" disabled class="btn btn-sm btn-disabled">{l("Loading…")}</button>
      {#elseif @membership == "invite_only" and @my_membership != true}
        <StatefulComponent
          id={"follow_feed_#{@object_id}" <> if(@activity_id, do: "_#{@activity_id}", else: "")}
          module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
          object_id={@object_id}
          object={@object}
          my_follow={@my_follow}
          path={@path}
          verb={lc("verb: action", "Follow", [], :bonfire_social_graph)}
          verb_undo={l("Unfollow")}
          verb_already={l("Following")}
          icon="ph:rss"
          icon_already="ph:rss"
          icon_class="size-4"
          container_class="inline-flex items-center gap-3"
          class="btn btn-primary btn-sm gap-2"
          class_already="btn btn-primary btn-sm gap-2"
          bell_class="btn btn-sm btn-circle border-0 bg-[var(--stream-surface,var(--color-base-200))] text-muted shadow-none hover:bg-[var(--stream-fill-hover,var(--color-base-300))] touch-target-expanded"
          bell_class_enabled="btn btn-sm btn-circle border-0 bg-[var(--stream-surface,var(--color-base-200))] text-primary shadow-none hover:bg-[var(--stream-fill-hover,var(--color-base-300))] touch-target-expanded"
          disabled={@disabled}
        />
      {#else}
        <button
          :if={@my_membership != true and @my_membership != :requested}
          type="button"
          id={@id}
          data-cid={@id}
          :on-click="Bonfire.UI.Groups:join_group"
          phx-value-id={@object_id}
          phx-value-component={@id}
          phx-disable-with={l("Loading…")}
          disabled={@disabled}
          class={@class || "btn btn-primary btn-sm"}
        >
          {if @membership == "on_request", do: l("Request to join"), else: l("Join")}
        </button>

        <button
          :if={@my_membership == :requested}
          type="button"
          id={@id}
          data-cid={@id}
          :on-click="Bonfire.UI.Groups:open_withdrawal"
          phx-value-id={@object_id}
          phx-value-component={@id}
          aria-haspopup="dialog"
          aria-controls="modal_box"
          phx-value-group-name={group_name(@object_name, @object)}
          disabled={@disabled}
          class={@class || "btn btn-primary btn-soft btn-sm", "gap-2"}
        >
          <#Icon iconify="ph:clock" class="size-4" aria-hidden="true" />
          {l("Pending")}
        </button>

        <button
          :if={@my_membership == true}
          type="button"
          id={@id}
          data-cid={@id}
          :on-click="Bonfire.UI.Groups:leave_group"
          phx-value-id={@object_id}
          phx-value-component={@id}
          phx-disable-with={l("Loading…")}
          disabled={@disabled}
          aria-label={l("Leave group")}
          class={@class || "btn btn-primary btn-sm", "group hover:btn-error focus-visible:btn-error"}
        >
          <span class="grid text-center">
            <span class="col-start-1 row-start-1 group-hover:invisible group-focus-visible:invisible">{l("Joined")}</span>
            <span
              class="col-start-1 row-start-1 invisible group-hover:visible group-focus-visible:visible"
              aria-hidden="true"
            >{l("Leave")}</span>
          </span>
        </button>

        <StatefulComponent
          :if={@my_membership == true or
            (Bonfire.Classify.Categories.follow_eligible?(@membership) and
               @my_membership != :requested)}
          id={"follow_feed_#{@object_id}" <> if(@activity_id, do: "_#{@activity_id}", else: "")}
          module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
          object_id={@object_id}
          object={@object}
          my_follow={@my_follow}
          path={@path}
          verb={l("Follow group")}
          verb_undo={l("Unfollow group")}
          verb_already={l("Following")}
          icon="ph:rss"
          icon_already="ph:rss"
          icon_class="size-4"
          container_class="inline-flex items-center gap-3"
          class="btn btn-sm btn-circle border-0 bg-[var(--stream-surface,var(--color-base-200))] text-muted shadow-none hover:bg-[var(--stream-fill-hover,var(--color-base-300))]"
          class_already="btn btn-sm btn-circle border-0 bg-[var(--stream-surface,var(--color-base-200))] text-primary shadow-none hover:bg-[var(--stream-fill-hover,var(--color-base-300))]"
          bell_class="btn btn-sm btn-circle border-0 bg-[var(--stream-surface,var(--color-base-200))] text-muted shadow-none hover:bg-[var(--stream-fill-hover,var(--color-base-300))] touch-target-expanded"
          bell_class_enabled="btn btn-sm btn-circle border-0 bg-[var(--stream-surface,var(--color-base-200))] text-primary shadow-none hover:bg-[var(--stream-fill-hover,var(--color-base-300))] touch-target-expanded"
          title={l("Follow group")}
          title_already={l("Unfollow group")}
          disabled={@disabled}
          hide_text
        />
      {/if}
    </div>
  {#else}
    <div class={if wrapper_visible?(@my_membership, @membership, @showing_within), do: @container_class}>
      {!-- Join / Request / Leave button --}
      {#if @my_membership == nil and current_user_id(@__context__)}
        <button disabled class={e(@class, "btn w-full btn-sm btn-disabled"), "normal-case"}>
          {if !@hide_text, do: l("loading..."), else: "..."}
        </button>
      {#elseif (!@my_membership or @my_membership == :skip) and @membership != "invite_only"}
        <a
          data-cid={@id}
          id={@id}
          :on-click={if !@disabled, do: "Bonfire.UI.Groups:join_group"}
          phx-disable-with={l("loading...")}
          phx-value-id={@object_id}
          class={
            e(@class, "btn w-full btn-sm btn-primary"),
            "btn-disabled": @disabled
          }
        >
          <div class="flex items-center gap-2">
            <#Icon iconify="ph:users-three-duotone" :if={!@hide_icon} class="w-4 h-4 shrink-0" />
            <span :if={!@hide_text} class={"truncate ellipsis", "ml-2": !@hide_icon}>
              {if @membership == "on_request", do: l("Request to join"), else: l("Join group")}
            </span>
          </div>
        </a>
      {#elseif @my_membership == :requested}
        <button
          type="button"
          data-cid={@id}
          id={@id}
          :on-click="Bonfire.UI.Groups:open_withdrawal"
          phx-value-id={@object_id}
          phx-value-component={@id}
          aria-label={@hide_text && l("Pending")}
          aria-haspopup="dialog"
          aria-controls="modal_box"
          phx-value-group-name={group_name(@object_name, @object)}
          disabled={@disabled}
          class={e(@class, "btn btn-info btn-sm btn-soft w-full"), "gap-2"}
        >
          <#Icon iconify="ph:clock" :if={!@hide_icon} class="size-4 shrink-0" aria-hidden="true" />
          <span :if={!@hide_text}>{l("Pending")}</span>
        </button>
      {#elseif @my_membership == true}
        {!-- Already a member --}
        <span class="w-full flex-1">
          <a
            phx-disable-with={l("loading...")}
            id={@id}
            data-cid={@id}
            :on-click={if !@disabled, do: "Bonfire.UI.Groups:leave_group"}
            phx-value-id={@object_id}
            phx-mouseover={JS.add_class("!btn-error", to: @id)
            |> JS.add_class("hidden", to: "##{@id}-normal")
            |> JS.remove_class("hidden", to: "##{@id}-hover")}
            phx-mouseout={JS.remove_class("!btn-error", to: @id)
            |> JS.remove_class("hidden", to: "##{@id}-normal")
            |> JS.add_class("hidden", to: "##{@id}-hover")}
            class={e(@class, "btn w-full btn-sm btn-primary btn-soft flex-1"), "btn-disabled": @disabled}
          >
            <div class="flex items-center gap-2">
              <#Icon iconify="ph:check-duotone" :if={!@hide_icon} class="w-4 h-4 shrink-0" />
              <span :if={!@hide_text} id={"#{@id}-normal"} class={"truncate ellipsis", "ml-2": !@hide_icon}>
                {l("Joined")}
              </span>
              <span
                :if={!@hide_text}
                id={"#{@id}-hover"}
                class={"hidden truncate ellipsis", "ml-2": !@hide_icon}
              >
                {l("Leave group")}
              </span>
            </div>
          </a>
        </span>
      {/if}

      {!-- Follow toggle: shown for members + memberships where Follow is the natural
       action (open / invite-only announcement channels). Suppressed in :list. --}
      <StatefulComponent
        :if={inner_follow_visible?(@my_membership, @membership, @showing_within)}
        id={"follow_feed_#{@object_id}" <> if(@activity_id, do: "_#{@activity_id}", else: "")}
        module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
        object_id={@object_id}
        object={@object}
        my_follow={@my_follow}
        path={@path}
        verb={lc("verb: action", "Follow", [], :bonfire_social_graph)}
        verb_undo={l("Unfollow")}
        verb_already={l("Following")}
        class="btn btn-sm w-full"
        bell_class="btn btn-sm btn-circle border-0 bg-[var(--stream-surface,var(--color-base-200))] text-muted shadow-none hover:bg-[var(--stream-fill-hover,var(--color-base-300))] touch-target-expanded"
        bell_class_enabled="btn btn-sm btn-circle border-0 bg-[var(--stream-surface,var(--color-base-200))] text-primary shadow-none hover:bg-[var(--stream-fill-hover,var(--color-base-300))] touch-target-expanded"
        hide_icon={false}
      />

      {!-- <div class="flex items-center gap-2" data-role="follow_wrapper">
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
      :if={(not is_nil(e(@user, :character, nil)) and e(@boundary_preset, "open", nil)) ||
        e(@boundary_preset, "visible", nil) || Boundaries.can?(@__context__, :follow, @user)}
      id={ComponentID.new(Bonfire.UI.Social.Graph.FollowButtonLive, id(@user), __MODULE__)}
      object_id={id(@user)}
      object={@user}
      follows_me={@follows_me}
      path={path(@user)}
      hide_icon
      class="btn btn-sm btn-neutral max-sm:touch-target focus-ring transition-interactive"
      verb={if e(@user, :type, nil) == :group,
        do: if(e(@boundary_preset, "open", nil), do: lc("verb: action", "Join", [], :bonfire_classify), else: l("Request to join"))}
      verb_undo={lc("verb: action", "Leave", [], :bonfire_classify)}
      verb_already={l("Joined")}
      disabled={Enums.ids(current_user(@__context__)) == Enums.ids(@moderators) |> debug("m111")}
    />
  </div> --}
    </div>
  {/if}
</div>
