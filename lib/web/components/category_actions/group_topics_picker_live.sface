<form
  id={"group-topics-picker-#{@group_id}"}
  data-role="group_topics_picker"
  phx-submit="Bonfire.Classify:apply_topic_choices"
  x-data="{ all: false }"
>
  <input type="hidden" name="group_id" value={@group_id}>
  <input type="hidden" name="mode" value={@mode}>

  {!-- a text button above the list rather than a checkbox row, so it doesn't read as one more topic. Was a checkbox labelled "All topics", styled like the rows --}
  <div class="flex justify-end pb-1">
    <button
      type="button"
      data-role="group_topics_picker_all"
      class="link link-hover text-sm text-muted"
      x-on:click="all = !all; $refs.topics.querySelectorAll('input[type=checkbox]:not(:disabled)').forEach(i => i.checked = all)"
    >
      <span x-show="!all">{l("Select all")}</span>
      <span x-show="all" x-cloak>{l("Select none")}</span>
    </button>
  </div>

  <ul x-ref="topics" class="divide-y divide-base-content/10">
    {#for topic <- @topics}
      <li data-topic-id={id(topic)} class="flex items-center gap-3 py-2">
        {#if id(topic) in @on_ids}
          {!-- already on: the existing button in its on state, so it can be turned off from here --}
          <span class="flex-1 truncate">{topic_name(topic)}</span>
          {#if @mode == :bell}
            <StatefulComponent
              module={maybe_component(Bonfire.Notify.Web.BellButtonLive, @__context__)}
              id={"topic_bell_#{id(topic)}"}
              object={topic}
              enabled
            />
          {#else}
            <StatefulComponent
              module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
              id={"topic_follow_#{id(topic)}"}
              object_id={id(topic)}
              object={topic}
              my_follow
              with_bell={false}
              hide_icon
              class="btn btn-sm btn-primary"
              class_already="btn btn-sm btn-soft"
              container_class="flex items-center gap-2"
            />
          {/if}
        {#elseif id(topic) in @needs_follow_ids}
          {!-- a mirrored topic's posts only arrive through a follow: its bell is locked until the Follow button's follow is sent --}
          <label for={"group-topics-picker-#{@group_id}-#{id(topic)}"} class="flex-1 truncate">{topic_name(topic)}</label>
          <StatefulComponent
            module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
            id={"topic_follow_#{id(topic)}"}
            object_id={id(topic)}
            object={topic}
            my_follow={false}
            with_bell={false}
            hide_icon
            class="btn btn-sm btn-primary"
            class_already="btn btn-sm btn-soft"
            container_class="flex items-center gap-2"
          >
            <:if_not_followed>
              <input type="checkbox" class="checkbox checkbox-sm" aria-label={topic_name(topic)} disabled>
            </:if_not_followed>
            <:if_followed>
              <input
                type="checkbox"
                name="topic_ids[]"
                id={"group-topics-picker-#{@group_id}-#{id(topic)}"}
                value={id(topic)}
                class="checkbox checkbox-sm"
                aria-label={topic_name(topic)}
              />
            </:if_followed>
          </StatefulComponent>
        {#else}
          <label class="flex flex-1 items-center gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="topic_ids[]"
              id={"group-topics-picker-#{@group_id}-#{id(topic)}"}
              value={id(topic)}
              class="checkbox checkbox-sm"
            />
            <span class="truncate">{topic_name(topic)}</span>
          </label>
        {/if}
      </li>
    {/for}
  </ul>

  <div class="mt-6 flex flex-wrap justify-end gap-3">
    <button type="button" :on-click="Bonfire.UI.Groups:close_dialog" class="btn btn-ghost focus-ring">{l("Skip")}</button>
    <button
      type="submit"
      data-role="group_topics_picker_submit"
      phx-disable-with={l("Saving…")}
      class="btn btn-primary focus-ring"
    >{submit_label(@mode)}</button>
  </div>
</form>
